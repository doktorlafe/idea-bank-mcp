{
  "name": "idea-bank",
  "version": "0.2.0",
  "description": "MCP server with a secret idea bank — store project ideas and get portfolio gap analysis to beat creative block",
  "type": "module",
  "license": "MIT",
  "bin": {
    "idea-bank": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ideas",
    "project-ideas",
    "portfolio",
    "brainstorming",
    "cli",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://git.laferrari.eu/lafe_trap/idea-bank.git"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "prepare": "npm run build",
    "serve": "tsx src/http.ts",
    "start:http": "node dist/http.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "funding": "https://github.com/sponsors/doktorlafe",
  "homepage": "https://ideas.laferrari.eu"
}
